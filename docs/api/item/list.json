{
    "openapi": "3.0.1",
    "info": {
      "title": "商品搜索接口",
      "description": "基于项目代码分析的商品搜索接口，支持分页、筛选、排序等功能",
      "version": "1.0.0"
    },
    "paths": {
      "/goods/items": {
        "get": {
          "summary": "商品搜索",
          "description": "获取商品列表，支持关键词搜索、分类筛选、价格排序等功能",
          "operationId": "searchItems",
          "tags": ["商品"],
          "parameters": [
            {
              "name": "page",
              "in": "query",
              "required": true,
              "description": "页码，从1开始",
              "schema": {
                "type": "integer",
                "minimum": 1
              },
              "example": 1
            },
            {
              "name": "pageSize",
              "in": "query",
              "required": true,
              "description": "每页数量",
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "example": 20
            },
            {
              "name": "keywords",
              "in": "query",
              "required": false,
              "description": "搜索关键词",
              "schema": {
                "type": "string"
              },
              "example": "手机"
            },
            {
              "name": "category",
              "in": "query",
              "required": false,
              "description": "分类ID",
              "schema": {
                "type": "string"
              },
              "example": "123"
            },
            {
              "name": "main_category",
              "in": "query",
              "required": false,
              "description": "主分类ID",
              "schema": {
                "type": "string"
              },
              "example": "456"
            },
            {
              "name": "tag_id",
              "in": "query",
              "required": false,
              "description": "标签ID",
              "schema": {
                "type": "string"
              },
              "example": "789"
            },
            {
              "name": "brand_id",
              "in": "query",
              "required": false,
              "description": "品牌ID，多个用逗号分隔",
              "schema": {
                "type": "string"
              },
              "example": "1,2,3"
            },
            {
              "name": "goodsSort",
              "in": "query",
              "required": false,
              "description": "排序方式：1-销量，2-价格降序，3-价格升序",
              "schema": {
                "type": "integer",
                "enum": [1, 2, 3]
              },
              "example": 1
            },
            {
              "name": "approve_status",
              "in": "query",
              "required": false,
              "description": "商品状态",
              "schema": {
                "type": "string",
                "enum": ["onsale,only_show"]
              },
              "example": "onsale,only_show"
            },
            {
              "name": "item_type",
              "in": "query",
              "required": false,
              "description": "商品类型",
              "schema": {
                "type": "string",
                "enum": ["normal"]
              },
              "example": "normal"
            },
            {
              "name": "is_point",
              "in": "query",
              "required": false,
              "description": "是否积分商品",
              "schema": {
                "type": "string",
                "enum": ["false", "true"]
              },
              "example": "false"
            },
            {
              "name": "distributor_id",
              "in": "query",
              "required": false,
              "description": "分销商ID",
              "schema": {
                "type": "string"
              },
              "example": "123"
            },
            {
              "name": "card_id",
              "in": "query",
              "required": false,
              "description": "兑换券ID",
              "schema": {
                "type": "string"
              },
              "example": "456"
            }
          ],
          "responses": {
            "200": {
              "description": "成功响应",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["list", "total_count"],
                    "properties": {
                      "list": {
                        "type": "array",
                        "description": "商品列表",
                        "items": {
                          "$ref": "#/components/schemas/ItemInfo"
                        }
                      },
                      "total_count": {
                        "type": "integer",
                        "description": "总数量"
                      },
                      "item_params_list": {
                        "type": "array",
                        "description": "商品参数筛选列表",
                        "items": {
                          "$ref": "#/components/schemas/ItemParam"
                        }
                      },
                      "select_tags_list": {
                        "type": "array",
                        "description": "可选标签列表",
                        "items": {
                          "$ref": "#/components/schemas/TagInfo"
                        }
                      },
                      "brand_list": {
                        "type": "object",
                        "description": "品牌列表",
                        "properties": {
                          "list": {
                            "type": "array",
                            "items": {
                              "$ref": "#/components/schemas/BrandInfo"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/goods/items/{item_id}": {
        "get": {
          "summary": "商品详情",
          "description": "获取商品详细信息",
          "operationId": "getItemDetail",
          "tags": ["商品"],
          "parameters": [
            {
              "name": "item_id",
              "in": "path",
              "required": true,
              "description": "商品ID",
              "schema": {
                "type": "string"
              },
              "example": "123"
            },
            {
              "name": "distributor_id",
              "in": "query",
              "required": false,
              "description": "分销商ID",
              "schema": {
                "type": "string"
              },
              "example": "456"
            }
          ],
          "responses": {
            "200": {
              "description": "成功响应",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ItemDetail"
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      }
    },
    "components": {
      "securitySchemes": {
        "BearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      },
      "schemas": {
        "ItemInfo": {
          "type": "object",
          "required": ["item_id", "item_name", "price"],
          "properties": {
            "item_id": {
              "type": "string",
              "description": "商品ID"
            },
            "item_name": {
              "type": "string",
              "description": "商品名称"
            },
            "brief": {
              "type": "string",
              "description": "商品简介"
            },
            "pics": {
              "type": "array",
              "description": "商品图片列表",
              "items": {
                "type": "string"
              }
            },
            "price": {
              "type": "integer",
              "description": "销售价格（分）"
            },
            "activity_price": {
              "type": "integer",
              "description": "活动价格（分）"
            },
            "market_price": {
              "type": "integer",
              "description": "市场价格（分）"
            },
            "member_price": {
              "type": "integer",
              "description": "会员价格（分）"
            },
            "vip_price": {
              "type": "integer",
              "description": "VIP价格（分）"
            },
            "svip_price": {
              "type": "integer",
              "description": "SVIP价格（分）"
            },
            "distributor_id": {
              "type": "string",
              "description": "分销商ID"
            },
            "distributor_info": {
              "type": "object",
              "description": "分销商信息",
              "properties": {
                "distributor_id": {
                  "type": "string"
                },
                "store_name": {
                  "type": "string"
                }
              }
            },
            "promotion_activity": {
              "type": "array",
              "description": "促销活动信息"
            },
            "origincountry_name": {
              "type": "string",
              "description": "原产地名称"
            },
            "origincountry_img_url": {
              "type": "string",
              "description": "原产地图片"
            },
            "type": {
              "type": "string",
              "description": "商品类型"
            },
            "store": {
              "type": "object",
              "description": "店铺信息"
            },
            "medicine_data": {
              "type": "object",
              "description": "药品数据"
            },
            "is_medicine": {
              "type": "boolean",
              "description": "是否药品"
            },
            "is_prescription": {
              "type": "boolean",
              "description": "是否需要处方"
            }
          }
        },
        "ItemDetail": {
          "type": "object",
          "required": ["item_id", "item_name", "price"],
          "properties": {
            "item_id": {
              "type": "string",
              "description": "商品ID"
            },
            "item_bn": {
              "type": "string",
              "description": "商品编号"
            },
            "itemName": {
              "type": "string",
              "description": "商品名称"
            },
            "brief": {
              "type": "string",
              "description": "商品简介"
            },
            "pics": {
              "type": "array",
              "description": "商品图片列表",
              "items": {
                "type": "string"
              }
            },
            "company_id": {
              "type": "string",
              "description": "公司ID"
            },
            "activity_info": {
              "type": "object",
              "description": "活动信息"
            },
            "activity_type": {
              "type": "string",
              "description": "活动类型"
            },
            "approve_status": {
              "type": "string",
              "description": "审核状态"
            },
            "point": {
              "type": "integer",
              "description": "积分"
            },
            "is_point": {
              "type": "boolean",
              "description": "是否积分商品"
            },
            "price": {
              "type": "integer",
              "description": "销售价格（分）"
            },
            "activity_price": {
              "type": "integer",
              "description": "活动价格（分）"
            },
            "market_price": {
              "type": "integer",
              "description": "市场价格（分）"
            },
            "member_price": {
              "type": "integer",
              "description": "会员价格（分）"
            },
            "vip_price": {
              "type": "integer",
              "description": "VIP价格（分）"
            },
            "svip_price": {
              "type": "integer",
              "description": "SVIP价格（分）"
            },
            "package_price": {
              "type": "integer",
              "description": "组合价格（分）"
            },
            "nospec": {
              "type": "boolean",
              "description": "无规格"
            },
            "item_spec_desc": {
              "type": "string",
              "description": "商品规格描述"
            },
            "vipgrade_guide_title": {
              "type": "string",
              "description": "VIP升级引导标题"
            },
            "kaquan_list": {
              "type": "array",
              "description": "优惠券列表"
            },
            "store": {
              "type": "object",
              "description": "店铺信息"
            },
            "store_setting": {
              "type": "object",
              "description": "店铺设置"
            },
            "limit_num": {
              "type": "integer",
              "description": "限购数量"
            },
            "purchase_limit_num_by_cart": {
              "type": "integer",
              "description": "购物车限购数量"
            },
            "purchase_limit_num_by_fastbuy": {
              "type": "integer",
              "description": "快速购买限购数量"
            },
            "is_gift": {
              "type": "boolean",
              "description": "是否赠品"
            },
            "regions": {
              "type": "array",
              "description": "产地列表",
              "items": {
                "type": "string"
              }
            },
            "item_unit": {
              "type": "string",
              "description": "计量单位"
            },
            "item_params": {
              "type": "array",
              "description": "商品参数",
              "items": {
                "type": "object",
                "properties": {
                  "attribute_name": {
                    "type": "string"
                  },
                  "attribute_value_name": {
                    "type": "string"
                  }
                }
              }
            },
            "groups_list": {
              "type": "array",
              "description": "组合列表"
            },
            "item_type": {
              "type": "string",
              "description": "商品类型"
            },
            "sales": {
              "type": "integer",
              "description": "销量"
            },
            "sales_setting": {
              "type": "object",
              "description": "销量设置"
            },
            "promotion_activity": {
              "type": "array",
              "description": "促销活动"
            },
            "start_num": {
              "type": "integer",
              "description": "起订量"
            }
          }
        },
        "ItemParam": {
          "type": "object",
          "properties": {
            "attribute_id": {
              "type": "string",
              "description": "属性ID"
            },
            "attribute_name": {
              "type": "string",
              "description": "属性名称"
            },
            "attribute_values": {
              "type": "array",
              "description": "属性值列表",
              "items": {
                "type": "object",
                "properties": {
                  "attribute_value_id": {
                    "type": "string"
                  },
                  "attribute_value_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "TagInfo": {
          "type": "object",
          "properties": {
            "tag_id": {
              "type": "string",
              "description": "标签ID"
            },
            "tag_name": {
              "type": "string",
              "description": "标签名称"
            }
          }
        },
        "BrandInfo": {
          "type": "object",
          "properties": {
            "brand_id": {
              "type": "string",
              "description": "品牌ID"
            },
            "brand_name": {
              "type": "string",
              "description": "品牌名称"
            },
            "brand_logo": {
              "type": "string",
              "description": "品牌logo"
            }
          }
        }
      }
    }
  }